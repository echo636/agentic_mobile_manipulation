+absl::optional<transform::Rigid3d>
+LocalTrajectoryBuilder2D::GetAuthoritativeOdometryPose(
+    const common::Time time) {
+  while (authoritative_odometry_data_.size() > 1 &&
+         authoritative_odometry_data_[1].time <= time) {
+    authoritative_odometry_data_.pop_front();
+  }
+  if (authoritative_odometry_data_.empty() ||
+      authoritative_odometry_data_.front().time > time) {
+    return absl::nullopt;
+  }
+  return authoritative_odometry_data_.front().pose;
+}
