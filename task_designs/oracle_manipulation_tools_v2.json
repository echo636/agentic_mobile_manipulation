[
  {
    "name": "grasp",
    "description": "Execute YOUR pregrasp, approach, close and verification paths. Never samples a grasp. All paths are EEF LINK poses with gripper=hold. For free objects provide a lift path; for articulated handles provide a small joint-consistent probe, not an upward lift.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "arm": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "frame": {
          "type": "string",
          "enum": [
            "robot_base"
          ]
        },
        "allow_trunk": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "target_object_id": {
          "type": "string"
        },
        "target_link": {
          "type": "string"
        },
        "grasp_kind": {
          "type": "string",
          "enum": [
            "free_object",
            "articulated_handle"
          ]
        },
        "pregrasp_waypoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "position_m": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "quaternion_xyzw": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "gripper": {
                "type": "string",
                "enum": [
                  "hold"
                ]
              }
            },
            "required": [
              "position_m",
              "quaternion_xyzw",
              "gripper"
            ],
            "additionalProperties": false
          }
        },
        "approach_waypoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "position_m": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "quaternion_xyzw": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "gripper": {
                "type": "string",
                "enum": [
                  "hold"
                ]
              }
            },
            "required": [
              "position_m",
              "quaternion_xyzw",
              "gripper"
            ],
            "additionalProperties": false
          }
        },
        "verification_waypoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "position_m": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "quaternion_xyzw": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "gripper": {
                "type": "string",
                "enum": [
                  "hold"
                ]
              }
            },
            "required": [
              "position_m",
              "quaternion_xyzw",
              "gripper"
            ],
            "additionalProperties": false
          }
        },
        "settle_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "min_lift_m": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.3
        }
      },
      "required": [
        "arm",
        "frame",
        "allow_trunk",
        "revision",
        "target_object_id",
        "target_link",
        "grasp_kind",
        "pregrasp_waypoints",
        "approach_waypoints",
        "verification_waypoints",
        "settle_steps",
        "min_lift_m"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "mas": {
        "profile": "oracle_waypoints",
        "mutates_world": true,
        "requires_fresh_observation": true,
        "closes_episode": false,
        "model_authored_motion": true
      }
    }
