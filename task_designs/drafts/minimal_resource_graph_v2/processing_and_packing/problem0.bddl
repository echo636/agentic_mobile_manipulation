(define (problem processing_and_packing_materials-0)
 (:domain behavior-1k)
 (:objects
  log.n.01_1 log.n.01_2 - log.n.01
  half__log.n.01_1 half__log.n.01_2 half__log.n.01_3 half__log.n.01_4 - half__log.n.01
  ax.n.01_1 - ax.n.01 carton.n.02_1 - carton.n.02
  countertop.n.01_1 countertop.n.01_2 - countertop.n.01
  cabinet.n.01_1 cabinet.n.01_2 - cabinet.n.01
  floor.n.01_1 - floor.n.01 agent.n.01_1 - agent.n.01)
 (:init
  (ontop log.n.01_1 countertop.n.01_1)
  (ontop log.n.01_2 countertop.n.01_1)
  (ontop ax.n.01_1 countertop.n.01_2)
  (ontop carton.n.02_1 floor.n.01_1)
  (nextto carton.n.02_1 cabinet.n.01_2)
  (future half__log.n.01_1) (future half__log.n.01_2)
  (future half__log.n.01_3) (future half__log.n.01_4)
  (inroom countertop.n.01_1 utility_room)
  (inroom countertop.n.01_2 utility_room)
  (inroom cabinet.n.01_1 utility_room) (inroom cabinet.n.01_2 utility_room)
  (inroom floor.n.01_1 utility_room) (ontop agent.n.01_1 floor.n.01_1))
 (:goal (and
  (not (real log.n.01_1)) (not (real log.n.01_2))
  (forall (?half__log.n.01 - half__log.n.01)
   (and (real ?half__log.n.01) (inside ?half__log.n.01 carton.n.02_1)))
  (ontop ax.n.01_1 countertop.n.01_1)
  (not (inside ax.n.01_1 carton.n.02_1))
  (ontop carton.n.02_1 floor.n.01_1)
  (nextto carton.n.02_1 cabinet.n.01_2))))
