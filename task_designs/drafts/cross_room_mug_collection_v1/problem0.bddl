; Authoring draft. Two mugs start on the dining table near the kitchen and two on
; the far laundry/utility-room counter; all four return directly onto the kitchen
; sink counter, the tray ends there empty. Carrier use and order remain optional.
(define (problem cross_room_mug_collection-0)
    (:domain behavior-1k)
    (:objects
        mug.n.04_1 mug.n.04_2 mug.n.04_3 mug.n.04_4 - mug.n.04
        tray.n.01_1 - tray.n.01
        countertop.n.01_1 countertop.n.01_2 - countertop.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        floor.n.01_1 floor.n.01_2 floor.n.01_3 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop mug.n.04_1 breakfast_table.n.01_1)
        (ontop mug.n.04_2 breakfast_table.n.01_1)
        (ontop mug.n.04_3 countertop.n.01_2)
        (ontop mug.n.04_4 countertop.n.01_2)
        (ontop tray.n.01_1 countertop.n.01_1)
        (inroom countertop.n.01_1 kitchen)
        (inroom countertop.n.01_2 utility_room)
        (inroom breakfast_table.n.01_1 dining_room)
        (inroom floor.n.01_1 kitchen)
        (inroom floor.n.01_2 dining_room)
        (inroom floor.n.01_3 utility_room)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    (:goal
        (and
            (ontop mug.n.04_1 countertop.n.01_1)
            (ontop mug.n.04_2 countertop.n.01_1)
            (ontop mug.n.04_3 countertop.n.01_1)
            (ontop mug.n.04_4 countertop.n.01_1)
            (ontop tray.n.01_1 countertop.n.01_1)
            (not (ontop mug.n.04_1 tray.n.01_1))
            (not (ontop mug.n.04_2 tray.n.01_1))
            (not (ontop mug.n.04_3 tray.n.01_1))
            (not (ontop mug.n.04_4 tray.n.01_1))
        )
    )
)
