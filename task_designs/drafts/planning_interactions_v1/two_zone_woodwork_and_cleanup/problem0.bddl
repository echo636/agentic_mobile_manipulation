; design_v1: goal-only native BDDL; no temporal gates or executable scene claim.
; Cutting and sweeping may be interleaved. Cutting does not imply new dust.
(define (problem two_zone_woodwork_and_cleanup-0)
    (:domain behavior-1k)
    (:objects
        log.n.01_1 log.n.01_2 log.n.01_3 log.n.01_4 - log.n.01
        half__log.n.01_1 half__log.n.01_2 half__log.n.01_3 half__log.n.01_4 half__log.n.01_5 half__log.n.01_6 half__log.n.01_7 half__log.n.01_8 - half__log.n.01
        ax.n.01_1 - ax.n.01
        broom.n.01_1 - broom.n.01
        dust.n.01_1 - dust.n.01
        carton.n.02_1 carton.n.02_2 - carton.n.02
        chopping_block.n.01_1 chopping_block.n.01_2 - chopping_block.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 floor.n.01_2 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    (:init
        (ontop log.n.01_1 floor.n.01_1)
        (ontop log.n.01_2 floor.n.01_1)
        (ontop log.n.01_3 floor.n.01_2)
        (ontop log.n.01_4 floor.n.01_2)
        (ontop chopping_block.n.01_1 floor.n.01_1)
        (ontop chopping_block.n.01_2 floor.n.01_2)
        (ontop carton.n.02_1 floor.n.01_1)
        (ontop carton.n.02_2 floor.n.01_2)
        (ontop ax.n.01_1 countertop.n.01_1)
        (ontop broom.n.01_1 countertop.n.01_1)
        (covered floor.n.01_1 dust.n.01_1)
        (covered floor.n.01_2 dust.n.01_1)
        (future half__log.n.01_1)
        (future half__log.n.01_2)
        (future half__log.n.01_3)
        (future half__log.n.01_4)
        (future half__log.n.01_5)
        (future half__log.n.01_6)
        (future half__log.n.01_7)
        (future half__log.n.01_8)
        (inroom floor.n.01_1 garage)
        (inroom floor.n.01_2 utility_room)
        (inroom countertop.n.01_1 utility_room)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    (:goal
        (and
            (forall
                (?half__log.n.01 - half__log.n.01)
                (and
                    (real ?half__log.n.01)
                    (exists
                        (?carton.n.02 - carton.n.02)
                        (inside ?half__log.n.01 ?carton.n.02)
                    )
                )
            )
            (ontop carton.n.02_1 floor.n.01_1)
            (ontop carton.n.02_2 floor.n.01_2)
            (not (covered floor.n.01_1 dust.n.01_1))
            (not (covered floor.n.01_2 dust.n.01_1))
            (ontop ax.n.01_1 countertop.n.01_1)
            (ontop broom.n.01_1 countertop.n.01_1)
        )
    )
)
