  "metrics_schema": {
    "same_table_rule": "任何效率对比必须在完成率不下降的前提下同表报告全部六项核心指标，不得只挑单一有利指标。",
    "required_metrics": [
      {
        "id": "completion_and_subgoals",
        "chinese_name": "完成率与子目标达成比例",
        "fields": [
          "run.json:evaluation.task_success",
          "run.json:evaluation.goal_satisfaction_fraction"
        ]
      },
      {
        "id": "agent_steps",
        "chinese_name": "步骤数（总步数 / 失败步数）",
        "fields": [
          "run.json:agent_steps_admitted",
          "run.json:failed_actions"
        ]
      },
      {
        "id": "robot_time_seconds",
        "chinese_name": "机器人时间 s（总计 = 路程 + 操作 + 等待）",
        "fields": [
          "run.json:robot_time.total_seconds",
          "run.json:robot_time.travel_seconds",
          "run.json:robot_time.manipulation_seconds",
          "run.json:robot_time.wait_seconds"
        ]
      },
      {
        "id": "trajectory_length_meters",
        "chinese_name": "原生 A* 行走轨迹长度 m",
        "fields": [
          "run.json:robot_time.travel_distance_m"
        ]
      },
      {
        "id": "wall_clock_seconds",
        "chinese_name": "墙钟时间 s（总计 = 模型推理 + 工具执行）",
        "fields": [
          "summary.json:wall_seconds",
          "summary.json:model_wall_seconds",
          "summary.json:tool_wall_seconds"
        ]
      },
      {
        "id": "token_usage",
        "chinese_name": "Token 消耗（总输入 / 缓存命中 / 输出）",
        "fields": [
          "summary.json:usage.input_tokens",
          "summary.json:usage.cached_input_tokens",
          "summary.json:usage.output_tokens"
        ]
      }
    ]
  },
